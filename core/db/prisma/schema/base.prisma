// Shared schema — used by both the local Electron app and the cloud app.
// Edit this file to change any table that both apps share.
// For cloud-only tables, see cloud.prisma in this same folder.

generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@local/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id         String            @id @default(uuid())
  code       String            @unique
  name       String            @unique
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  majors     Major[]
  templates  PlannerTemplate[]

  @@map("courses")
}

model Major {
  id         String            @id @default(uuid())
  course_id  String
  course     Course            @relation(fields: [course_id], references: [id])
  name       String
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  templates  PlannerTemplate[]

  @@unique([course_id, name])
  @@map("majors")
}

model Unit {
  id                      String                      @id @default(uuid())
  unit_code               String                      @unique
  unit_name               String
  offered_in              Int?
  created_at              DateTime                    @default(now())
  updated_at              DateTime                    @updatedAt
  templates               TemplateUnit[]
  requisite_groups        UnitRequisiteGroup[]
  requisite_conditions    UnitRequisiteCondition[] @relation("RequisiteUnit")
  elective_group_units    ElectiveGroupUnit[]
  minor_units             MinorUnit[] 

  @@map("units")
}

model UnitRequisiteGroup {
  id         String                      @id @default(uuid())
  unit_id    String
  unit       Unit                        @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  conditions UnitRequisiteCondition[]

  @@map("unit_requisite_groups")
}

model UnitRequisiteCondition {
  id                String                @id @default(uuid())
  group_id          String
  group             UnitRequisiteGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  type              String
  unit_id           String?
  unit              Unit?                 @relation("RequisiteUnit", fields: [unit_id], references: [id], onDelete: Cascade)
  credit_points     Decimal?
  requisite_type    String?

  @@map("unit_requisite_conditions")
}

model PlannerTemplate {
  id             String  @id @default(uuid())
  course_id      String
  course         Course  @relation(fields: [course_id], references: [id])
  major_id       String?
  major          Major?  @relation(fields: [major_id], references: [id])
  intake_year    Int
  intake_month   Int?

  course_type        String @default("bachelor")
  duration_semesters Int    @default(6)

  core_count     Int?
  core_cp        Int?
  major_count    Int?
  major_cp       Int?
  elective_count Int?
  elective_cp    Int?
  wil_count      Int?
  wil_cp         Int?

  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  units           TemplateUnit[]
  elective_groups ElectiveGroup[]
  minors          Minor[]

  @@unique([course_id, major_id, intake_year, intake_month])
  @@map("planner_templates")
}

enum unit_category {
  core
  major_core
  prescribed_elective
  elective
  wil
  mpu
}

model TemplateUnit {
  id                  String          @id @default(uuid())
  planner_template_id String
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id])
  unit_id             String?
  unit                Unit?           @relation(fields: [unit_id], references: [id])
  category            unit_category
  year_level          Int
  semester            Int
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  @@unique([planner_template_id, unit_id])
  @@map("template_units")
}

model ElectiveGroup {
  id                  String              @id @default(uuid())
  planner_template_id String
  template            PlannerTemplate     @relation(fields: [planner_template_id], references: [id])
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  units               ElectiveGroupUnit[]

  @@map("elective_groups")
}

model ElectiveGroupUnit {
  elective_group_id String
  elective_group    ElectiveGroup @relation(fields: [elective_group_id], references: [id], onDelete: Cascade)
  unit_id           String
  unit              Unit          @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([elective_group_id, unit_id])
  @@map("elective_group_units")
}

model Minor {
  id                  String          @id @default(uuid())
  planner_template_id String
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id], onDelete: Cascade)
  name                String
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  units               MinorUnit[]

  @@unique([planner_template_id, name])
  @@map("minors")
}

model MinorUnit {
  minor_id String
  minor    Minor  @relation(fields: [minor_id], references: [id], onDelete: Cascade)
  unit_id  String
  unit     Unit   @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([minor_id, unit_id])
  @@map("minor_units")
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @updatedAt

  @@map("system_config")
}

model PrivacyAcknowledgement {
  id              Int      @id @default(1)
  notice_version  Int
  acknowledged_at DateTime @default(now())

  @@map("privacy_acknowledgement")
}

model SecurityIncidentLog {
  id          BigInt   @id @default(autoincrement())
  event_type  String
  severity    String   @default("warning")
  message     String
  occurred_at DateTime @default(now())

  @@map("security_incident_log")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  action       String
  entity_type  String?
  entity_id    String?
  old_value    Json?
  new_value    Json?
  performed_at DateTime @default(now())

  @@map("audit_log")
}

model SchemaMigration {
  version     String   @id
  description String?
  applied_at  DateTime @default(now())

  @@map("schema_migrations")
}
