// Schema of the desktop app (embedded PostgreSQL). The student web app has its own schema in student/prisma.
// The migrations are in the `migrations` folder next to this file. This file must describe exactly what they build:
// tests/integration-db/migrations.test.ts fails when it does not (run `prisma migrate diff`, see docs/ai/data-model.md).

generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@local/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String?           @unique @db.VarChar(50)
  name       String            @db.VarChar(255)
  created_at DateTime          @default(now()) @db.Timestamptz
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz
  majors     Major[]
  templates  PlannerTemplate[]
  @@index([code], map: "idx_courses_code")

  @@map("courses")
}

model Major {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id  String            @db.Uuid
  course     Course            @relation(fields: [course_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name       String            @db.VarChar(255)
  created_at DateTime          @default(now()) @db.Timestamptz
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz
  templates  PlannerTemplate[]

  @@unique([course_id, name])
  @@index([course_id], map: "idx_majors_course")
  @@map("majors")
}

model Unit {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_code            String                   @unique @db.VarChar(20)
  unit_name            String                   @db.VarChar(255)
  is_active            Boolean                  @default(true)
  replaced_by_unit_id  String?                  @db.Uuid
  replaced_by          Unit?                    @relation("UnitReplacement", fields: [replaced_by_unit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replaces_units       Unit[]                   @relation("UnitReplacement")
  created_at           DateTime                 @default(now()) @db.Timestamptz
  updated_at           DateTime                 @default(now()) @updatedAt @db.Timestamptz
  offerings            UnitOffering[]
  templates            TemplateUnit[]
  requisite_groups     UnitRequisiteGroup[]
  requisite_conditions UnitRequisiteCondition[] @relation("RequisiteUnit")
  elective_group_units ElectiveGroupUnit[]
  minor_units          MinorUnit[]
  @@index([unit_code], map: "idx_units_code")
  @@index([is_active], map: "idx_units_active")
  @@index([replaced_by_unit_id], map: "idx_units_replaced_by")

  @@map("units")
}

model UnitOffering {
  unit_id    String   @db.Uuid
  unit       Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offered_in Int      @map("offered_in") @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@id([unit_id, offered_in])
  @@index([offered_in], map: "idx_unit_offerings_term")
  @@map("unit_offerings")
}

model UnitRequisiteGroup {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id    String                   @db.Uuid
  unit       Unit                     @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conditions UnitRequisiteCondition[]
  @@index([unit_id], map: "idx_requisite_group_unit")

  @@map("unit_requisite_groups")
}

model UnitRequisiteCondition {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id           String             @db.Uuid
  group              UnitRequisiteGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type               String             @db.VarChar(20)
  unit_id            String?            @db.Uuid
  unit               Unit?              @relation("RequisiteUnit", fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_points      Decimal?           @db.Decimal(5, 1)
  requisite_type     String?            @db.VarChar(20)
  external_requisite String?            @db.VarChar(255)
  @@index([group_id], map: "idx_requisite_cond_group")
  @@index([unit_id], map: "idx_requisite_cond_unit")

  @@map("unit_requisite_conditions")
}

model PlannerTemplate {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id          String          @db.Uuid
  course             Course          @relation(fields: [course_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  major_id           String?         @db.Uuid
  major              Major?          @relation(fields: [major_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  intake_year        Int             @db.SmallInt
  intake_month       Int?            @db.SmallInt
  course_type        String          @default("bachelor") @db.VarChar(50)
  duration_semesters Int             @default(6) @db.SmallInt
  core_count         Int?            @db.SmallInt
  core_cp            Int?            @db.SmallInt
  major_count        Int?            @db.SmallInt
  major_cp           Int?            @db.SmallInt
  elective_count     Int?            @db.SmallInt
  elective_cp        Int?            @db.SmallInt
  wil_count          Int?            @db.SmallInt
  wil_cp             Int?            @db.SmallInt
  created_at         DateTime        @default(now()) @db.Timestamptz
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz
  units              TemplateUnit[]
  elective_groups    ElectiveGroup[]
  minors             Minor[]

  @@unique([course_id, major_id, intake_year, intake_month])
  @@index([course_id], map: "idx_planner_course")
  @@index([course_id, major_id], map: "idx_planner_course_major")
  @@index([course_id, intake_year, intake_month], map: "idx_planner_course_intake")
  @@map("planner_templates")
}

enum unit_category {
  core
  major_core
  prescribed_elective
  elective
  wil
  mpu
}

model TemplateUnit {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_template_id String          @db.Uuid
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit_id             String?         @db.Uuid
  unit                Unit?           @relation(fields: [unit_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category            unit_category
  year_level          Int             @db.SmallInt
  semester            Int             @db.SmallInt
  created_at          DateTime        @default(now()) @db.Timestamptz
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz

  @@unique([planner_template_id, unit_id])
  @@index([planner_template_id], map: "idx_template_units_template")
  @@index([unit_id], map: "idx_template_units_unit")
  @@map("template_units")
}

model ElectiveGroup {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_template_id String              @db.Uuid
  template            PlannerTemplate     @relation(fields: [planner_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_at          DateTime            @default(now()) @db.Timestamptz
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz
  units               ElectiveGroupUnit[]
  @@index([planner_template_id], map: "idx_elective_group_template")

  @@map("elective_groups")
}

model ElectiveGroupUnit {
  elective_group_id String        @db.Uuid
  elective_group    ElectiveGroup @relation(fields: [elective_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit_id           String        @db.Uuid
  unit              Unit          @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([elective_group_id, unit_id])
  @@map("elective_group_units")
}

model Minor {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_template_id String          @db.Uuid
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name                String          @db.VarChar(255)
  created_at          DateTime        @default(now()) @db.Timestamptz
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz
  units               MinorUnit[]

  @@unique([planner_template_id, name])
  @@index([planner_template_id], map: "idx_minors_planner")
  @@map("minors")
}

model MinorUnit {
  minor_id String @db.Uuid
  minor    Minor  @relation(fields: [minor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit_id  String @db.Uuid
  unit     Unit   @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([minor_id, unit_id])
  @@index([unit_id], map: "idx_minor_units_unit")
  @@map("minor_units")
}

model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       String
  description String?
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("system_config")
}

model PrivacyEvent {
  id             BigInt   @id @default(autoincrement())
  event_type     String   @db.VarChar(20)
  notice_version Int
  occurred_at    DateTime @default(now()) @db.Timestamptz

  @@map("privacy_events")
}

model SecurityIncidentLog {
  id          BigInt   @id @default(autoincrement())
  event_type  String   @db.VarChar(50)
  severity    String   @default("warning") @db.VarChar(20)
  message     String
  occurred_at DateTime @default(now()) @db.Timestamptz
  @@index([occurred_at(sort: Desc)], map: "idx_incident_occurred")

  @@map("security_incident_log")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  action       String   @db.VarChar(50)
  entity_type  String?  @db.VarChar(50)
  entity_id    String?  @db.Uuid
  old_value    Json?
  new_value    Json?
  performed_at DateTime @default(now()) @db.Timestamptz
  @@index([performed_at(sort: Desc)], map: "idx_audit_performed")

  @@map("audit_log")
}


// ======================================================================
// Class estimation run history (Phase 8)
//
// A saved run is a snapshot, not a live view. It records the figures AND the inputs that produced them,
// because an estimate read six months later is meaningless without knowing the retention rate, the load cap
// and the new-intake figure behind it. Re-deriving those from current settings would misreport history.
//
// unit_code is stored as text rather than a foreign key to units on purpose. A run is a historical record,
// and a unit being renamed or removed from the catalogue later must not rewrite or break a past estimate.
// ======================================================================

model EstimationRun {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  /// Optional note from whoever ran it, e.g. "before the FTES change".
  label      String?  @db.VarChar(200)

  /// The semester estimated, as a calendar year and semester.
  target_year     Int
  target_semester Int @db.SmallInt

  /// The inputs, kept so a past run can be read without guessing what produced it.
  load_cap       Int
  retention_rate Decimal @db.Decimal(4, 3)
  new_intake     Int

  /// The course the students were detected to belong to, e.g. "Bachelor of Computer Science". Text rather
  /// than a link to courses, like unit_code below, so a course renamed later does not rewrite history.
  /// Null on estimates saved before courses were recorded.
  course        String? @db.VarChar(255)

  /// Where the transcripts came from: portal, import, mock, or mixed.
  source        String @db.VarChar(20)
  student_count Int
  /// Distinct situations the students collapsed into, so a run's batching is visible after the fact.
  group_count   Int
  /// Students estimated from the shared core because no major could be detected.
  common_core_count Int @default(0)

  units EstimationRunUnit[]

  @@index([created_at])
  @@map("estimation_runs")
}

model EstimationRunUnit {
  run_id String        @db.Uuid
  run    EstimationRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  unit_code String @db.VarChar(20)

  /// Whole students the planner said still owed the unit.
  from_named_picks Decimal @db.Decimal(10, 4)
  /// Fractional shares from students spread across an elective pool holding the unit.
  from_electives   Decimal @db.Decimal(10, 4)
  /// Students from the manual new-intake figure, which is not discounted by retention.
  from_new_intake  Decimal @db.Decimal(10, 4)
  /// The final fractional projection, kept alongside the rounded figure so the rounding stays inspectable.
  projected        Decimal @db.Decimal(10, 4)
  /// The whole-student figure to staff against.
  headcount        Int

  @@id([run_id, unit_code])
  @@index([unit_code])
  @@map("estimation_run_units")
}
