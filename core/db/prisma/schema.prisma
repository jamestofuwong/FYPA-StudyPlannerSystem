generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@local/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id         String            @id @default(uuid())
  code       String            @unique
  name       String
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  majors     Major[]
  templates  PlannerTemplate[]

  @@map("courses")
}

model Major {
  id         String            @id @default(uuid())
  course_id  String
  course     Course            @relation(fields: [course_id], references: [id])
  name       String
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  templates  PlannerTemplate[]

  @@unique([course_id, name])
  @@map("majors")
}

model Unit {
  id                      String                      @id @default(uuid())
  unit_code               String                      @unique
  unit_name               String
  offered_in              Int?
  created_at              DateTime                    @default(now())
  updated_at              DateTime                    @updatedAt
  templates               TemplateUnit[]
  prerequisite_groups     UnitPrerequisiteGroup[]
  prerequisite_conditions UnitPrerequisiteCondition[] @relation("PrerequisiteUnit")
  elective_group_units    ElectiveGroupUnit[]

  @@map("units")
}

model UnitPrerequisiteGroup {
  id         String                      @id @default(uuid())
  unit_id    String
  unit       Unit                        @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  conditions UnitPrerequisiteCondition[]

  @@map("unit_prerequisite_groups")
}

model UnitPrerequisiteCondition {
  id                String                @id @default(uuid())
  group_id          String
  group             UnitPrerequisiteGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  prerequisite_type String
  unit_id           String?
  unit              Unit?                 @relation("PrerequisiteUnit", fields: [unit_id], references: [id], onDelete: Cascade)
  credit_points     Decimal?

  @@map("unit_prerequisite_conditions")
}

model PlannerTemplate {
  id             String          @id @default(uuid())
  course_id      String
  course         Course          @relation(fields: [course_id], references: [id])
  major_id       String?
  major          Major?          @relation(fields: [major_id], references: [id])
  intake_year    Int
  intake_month   Int?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  units          TemplateUnit[]
  elective_groups ElectiveGroup[]

  @@unique([course_id, major_id, intake_year, intake_month])
  @@map("planner_templates")
}

enum unit_category {
  core
  major_core
  prescribed_elective
  elective
  wil
  mpu
}

model TemplateUnit {
  id                  String          @id @default(uuid())
  planner_template_id String
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id])
  unit_id             String?
  unit                Unit?           @relation(fields: [unit_id], references: [id])
  category            unit_category
  year_level          Int
  semester            Int
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  @@unique([planner_template_id, unit_id])
  @@map("template_units")
}

model ElectiveGroup {
  id                  String               @id @default(uuid())
  planner_template_id String
  template            PlannerTemplate      @relation(fields: [planner_template_id], references: [id])
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  units               ElectiveGroupUnit[]

  @@map("elective_groups")
}

model ElectiveGroupUnit {
  elective_group_id String
  elective_group    ElectiveGroup @relation(fields: [elective_group_id], references: [id], onDelete: Cascade)
  unit_id           String
  unit              Unit          @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([elective_group_id, unit_id])
  @@map("elective_group_units")
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @updatedAt

  @@map("system_config")
}

model PrivacyAcknowledgement {
  id              Int      @id @default(1)
  notice_version  Int
  acknowledged_at DateTime @default(now())

  @@map("privacy_acknowledgement")
}

model SecurityIncidentLog {
  id          BigInt   @id @default(autoincrement())
  event_type  String
  severity    String   @default("warning")
  message     String
  occurred_at DateTime @default(now())

  @@map("security_incident_log")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  action       String
  entity_type  String?
  entity_id    String?
  old_value    Json?
  new_value    Json?
  performed_at DateTime @default(now())

  @@map("audit_log")
}

model SchemaMigration {
  version    String   @id
  description String?
  applied_at DateTime @default(now())

  @@map("schema_migrations")
}