-- =============================================================================
-- Study Planner System — Database Initialisation Script
-- =============================================================================
-- Scope  : Persistent storage for study planner templates ONLY.
--          Student data is NEVER stored here (REQ-CON-105, REQ-DB-102).
-- DBMS   : PostgreSQL (local, bundled)
-- Version: 1.7.0  |  Sprint 3 — Restructured requisite tables (renamed from prerequisite),
--                    added requisite_type column (prerequisite/corequisite/antirequisite)
--                    to unit_requisite_conditions table.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Extensions
-- ---------------------------------------------------------------------------
CREATE EXTENSION IF NOT EXISTS "pgcrypto";   -- gen_random_uuid()


-- ===========================================================================
-- SECTION 1 — CONFIGURATION
-- Stores system-wide, administrator-adjustable settings.
-- Supports REQ-FUN-610 (configurable second-major threshold).
-- ===========================================================================

CREATE TABLE system_config (
    key         VARCHAR(100)  PRIMARY KEY,
    value       TEXT          NOT NULL,
    description TEXT,
    updated_at  TIMESTAMPTZ   NOT NULL DEFAULT now()
);

-- Seed default configuration values
INSERT INTO system_config (key, value, description) VALUES
    ('second_major_threshold',        '70',   'Minimum match percentage (%) to qualify as a second major (REQ-FUN-610)'),
    ('planner_fallback_latest',       'false','If true, fall back to most recent planner version when intake year has no exact match (REQ-FUN-608)'),
    ('privacy_notice_version',        '1',    'Increment to force re-acknowledgement of the privacy notice (REQ-PRI-103)'),
    ('app_password_hash',             '',     'bcrypt hash of the application access password (REQ-SEC-203)'),
    ('security_incident_log_enabled', 'true', 'Enable security incident logging (REQ-BRE-101)');


-- ===========================================================================
-- SECTION 2 — COURSES
-- Top-level academic programmes as awarded by the university.
-- A course is what a student is *enrolled in* (returned by the scraper).
-- One course contains one or more majors/specialisations.
-- e.g. "Bachelor of Computer Science" -> majors: Cybersecurity, AI, IoT
-- Supports REQ-FUN-104 (scraper returns course), REQ-FUN-602 (filter templates
-- by course before major detection).
-- ===========================================================================

CREATE TABLE courses (
    id               UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    code             VARCHAR(50)   UNIQUE,            -- e.g. 'BCS', 'BIT', 'BSE'
    name             VARCHAR(255)  NOT NULL,          -- e.g. 'Bachelor of Computer Science'
    created_at       TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at       TIMESTAMPTZ   NOT NULL DEFAULT now()
);

COMMENT ON TABLE courses IS
    'Top-level academic programmes students enrol in. REQ-FUN-104, REQ-FUN-602';

CREATE INDEX idx_courses_code ON courses(code);


-- ===========================================================================
-- SECTION 3 — MAJORS
-- Specialisations that sit *within* a course.
-- A student is detected as having a major; they are enrolled in a course.
-- Supports REQ-DB-102.3.
-- ===========================================================================

CREATE TABLE majors (
    id          UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    course_id   UUID          NOT NULL REFERENCES courses(id) ON DELETE RESTRICT,
    name        VARCHAR(255)  NOT NULL,          -- e.g. 'AI'
    created_at  TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at  TIMESTAMPTZ   NOT NULL DEFAULT now(),

    UNIQUE (course_id, name)
);

COMMENT ON TABLE majors IS
    'Specialisations within a course. REQ-DB-102.3';

-- Fast lookup: "give me all majors for this course" — used during major detection
-- to pre-filter planner templates to only those relevant to the student's course.
CREATE INDEX idx_majors_course ON majors(course_id);


-- ===========================================================================
-- SECTION 4 — UNITS (GLOBAL CATALOGUE)
-- Master list of all known units derived from uploaded planners.
-- Supports REQ-DB-102.1.
--
-- Note: credit_hours is intentionally absent. It does not appear on study
-- planner PDFs and is not required by the graduation eligibility check.
-- Graduation is determined by unit completion against template requirements,
-- not by accumulating credit hours. See REQ-FUN-305.
-- ===========================================================================

CREATE TABLE units (
    id            UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    unit_code     VARCHAR(20)   NOT NULL UNIQUE,    -- e.g. 'COS40003', 'COS20031'
    unit_name     VARCHAR(255)  NOT NULL,
    offered_in    SMALLINT      DEFAULT NULL    CHECK (offered_in BETWEEN 1 AND 2), -- e.g. 1 or 2, null for every semester
    created_at    TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at    TIMESTAMPTZ   NOT NULL DEFAULT now()
);

COMMENT ON TABLE units IS
    'Global unit catalogue. Populated from planner PDFs. REQ-DB-102.1';

-- Requisite relationships between units (derived from planners).
-- Uses two tables to support AND/OR logic and credit point requirements:
-- unit_requisite_groups — one group per OR branch
-- unit_requisite_conditions — all conditions within a group = AND logic
CREATE TABLE unit_requisite_groups (
    id       UUID  PRIMARY KEY DEFAULT gen_random_uuid(),
    unit_id  UUID  NOT NULL REFERENCES units(id) ON DELETE CASCADE
);

COMMENT ON TABLE unit_requisite_groups IS
    'Groups of requisites for a unit. Multiple groups = OR logic. REQ-DB-102.1, REQ-FUN-303';

-- Requisite conditions — all conditions within a group must be met (AND logic)
CREATE TABLE unit_requisite_conditions (
    id                  UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
    group_id            UUID         NOT NULL REFERENCES unit_requisite_groups(id) ON DELETE CASCADE,
    type                VARCHAR(20)  NOT NULL CHECK (type IN ('unit', 'credit_points')),
    unit_id             UUID         NULL REFERENCES units(id) ON DELETE CASCADE,
    credit_points       NUMERIC(5,1) NULL,
    requisite_type      VARCHAR(20)  NULL CHECK (requisite_type IN ('prerequisite', 'corequisite', 'antirequisite')),
    CONSTRAINT valid_condition CHECK (
        (
            type = 'unit'
            AND unit_id IS NOT NULL
            AND credit_points IS NULL
            AND requisite_type IS NOT NULL
        ) OR (
            type = 'credit_points'
            AND credit_points IS NOT NULL
            AND unit_id IS NULL
            AND requisite_type IS NULL
        )
    )
);

COMMENT ON TABLE unit_requisite_conditions IS
    'Individual conditions within a requisite group. All conditions in a group = AND logic. REQ-DB-102.1, REQ-FUN-303';


-- ===========================================================================
-- SECTION 5 — PLANNER TEMPLATES
-- A template always belongs to a course (NOT NULL) and optionally to a major
-- within that course (nullable). This supports three cases:
--   - course_id set, major_id set   -> major-specific planner (e.g. CS > AI)
--   - course_id set, major_id NULL  -> course-level planner, no major
--                                     (e.g. Foundation in Engineering, BAccounting)
--   - major_id without course_id    -> prevented by trigger below
--
-- Intake is identified by year + month. intake_month is nullable:
--   - intake_month set   -> month-specific planner (e.g. Feb/Mar 2022, Aug/Sept 2022)
--   - intake_month NULL  -> applies to all intakes within the year (year-level fallback)
--
-- Requirement counts and credit points are stored per category:
--   - core_count / core_cp           -> core units required
--   - major_count / major_cp         -> major units required
--   - elective_count / elective_cp   -> elective units required
--   - wil_count / wil_cp             -> WIL units required
-- Values are extracted from planner PDFs. NULL = not specified.
--
-- Integrity rule: if major_id is provided, it must belong to the same course
-- as course_id — enforced via trigger below.
--
-- Note: total_credit_hours is intentionally absent. Graduation eligibility is
-- determined at runtime by checking unit completion against template_units,
-- not by comparing a stored credit target. See REQ-FUN-305.
--
-- Supports REQ-DB-102.2, REQ-FUN-404 to REQ-FUN-406, REQ-FUN-602.
-- ===========================================================================

CREATE TABLE planner_templates (
    id              UUID          PRIMARY KEY DEFAULT gen_random_uuid(),

    -- Ownership: course is always required; major is optional
    course_id       UUID          NOT NULL REFERENCES courses(id) ON DELETE RESTRICT,
    major_id        UUID          NULL     REFERENCES majors(id)  ON DELETE RESTRICT,

    -- Intake identification
    intake_year     SMALLINT      NOT NULL,
                    -- e.g. 2022
    intake_month    SMALLINT      NULL
                        CHECK (intake_month BETWEEN 1 AND 12),
                    -- e.g. 3 = March, 7 = July, 10 = October
                    -- NULL = year-level template (no month-specific variant issued)

    -- Course metadata
    course_type         VARCHAR(50)   NOT NULL DEFAULT 'bachelor',
                        -- e.g. 'bachelor', 'diploma', 'foundation'
    duration_semesters  SMALLINT      NOT NULL DEFAULT 6,
                        -- e.g. 6, 8

    -- Requirement counts and credit points
    core_count      SMALLINT      NULL,
    core_cp         SMALLINT      NULL,
    major_count     SMALLINT      NULL,
    major_cp        SMALLINT      NULL,
    elective_count  SMALLINT      NULL,
    elective_cp     SMALLINT      NULL,
    wil_count       SMALLINT      NULL,
    wil_cp          SMALLINT      NULL,

    created_at      TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ   NOT NULL DEFAULT now(),

    -- Uniqueness: no two templates may share the same course + major + year + month.
    -- NULL intake_month is treated as its own distinct value by PostgreSQL UNIQUE,
    -- correctly separating year-level templates from month-specific ones.
    UNIQUE (course_id, major_id, intake_year, intake_month)
);

COMMENT ON TABLE planner_templates IS
    'One row per course × [major] × intake-year × [intake-month] '
    'major_id NULL = no specialisation. intake_month NULL = year-level fallback. '
    'REQ-DB-102.2, REQ-FUN-404–406';

-- Trigger to enforce: if major_id is supplied, it must belong to course_id.
-- Cannot express this as a simple CHECK because it requires a cross-table lookup.
CREATE OR REPLACE FUNCTION check_major_belongs_to_course()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF NEW.major_id IS NOT NULL THEN
        IF NOT EXISTS (
            SELECT 1 FROM majors
            WHERE id        = NEW.major_id
              AND course_id = NEW.course_id
        ) THEN
            RAISE EXCEPTION
                'major_id % does not belong to course_id %',
                NEW.major_id, NEW.course_id;
        END IF;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_planner_major_course_check
    BEFORE INSERT OR UPDATE ON planner_templates
    FOR EACH ROW EXECUTE FUNCTION check_major_belongs_to_course();


-- ===========================================================================
-- SECTION 6 — TEMPLATE UNITS
-- Defines every unit's role inside a specific planner template.
-- Supports REQ-FUN-402, REQ-FUN-603, REQ-DB-103.
-- ===========================================================================

-- Unit categories recognised by the matching algorithm (REQ-FUN-603)
CREATE TYPE unit_category AS ENUM (
    'core',                  -- Programme core; must complete
    'major_core',            -- Major-specific core unit
    'prescribed_elective',   -- Compulsory elective; unit always defined in planner
    'elective',              -- Elective; unit_id filled (new planner) or NULL (old planner)
    'wil',                   -- Work-Integrated Learning
    'mpu'                    -- Mata Pelajaran Umum (co-curriculum / compulsory MPU)
);

CREATE TABLE template_units (
    id                  UUID            PRIMARY KEY DEFAULT gen_random_uuid(),
    planner_template_id UUID            NOT NULL
                            REFERENCES planner_templates(id) ON DELETE CASCADE,
    unit_id             UUID            NULL
                            REFERENCES units(id) ON DELETE RESTRICT,

    category            unit_category   NOT NULL,
    year_level          SMALLINT        NOT NULL CHECK (year_level BETWEEN 1 AND 6),
    semester            SMALLINT        NOT NULL CHECK (semester BETWEEN 1 AND 4),
                        -- 1 = Semester 1
                        -- 2 = Semester 2
                        -- 3 = Summer Term
                        -- 4 = Winter Term

    created_at      TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ   NOT NULL DEFAULT now(),

    -- unit_id can only be NULL for elective category (old planner version)
    -- all other categories must have a unit_id defined
    CONSTRAINT unit_id_required CHECK (
        (category = 'elective' AND unit_id IS NULL) OR
        (unit_id IS NOT NULL)
    ),

    UNIQUE (planner_template_id, unit_id)
);

COMMENT ON TABLE template_units IS
    'Per-unit requirements within a planner template. REQ-FUN-603, REQ-DB-103';

-- Index for the hot path: major detection iterates over all template_units
-- for every stored planner template.
CREATE INDEX idx_template_units_template ON template_units(planner_template_id);
CREATE INDEX idx_template_units_unit     ON template_units(unit_id);


-- ===========================================================================
-- SECTION 7a — ELECTIVE GROUPS
-- Named pools of units that satisfy a single elective slot.
-- Implements the elective-overlap rule (REQ-DB-103).
-- Example: "Science Elective" pool may include CHE301, PHY301, BIO301.
-- ===========================================================================

CREATE TABLE elective_groups (
    id                  UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    planner_template_id UUID          NOT NULL
                            REFERENCES planner_templates(id) ON DELETE CASCADE,
    created_at          TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at          TIMESTAMPTZ   NOT NULL DEFAULT now()
);

CREATE TABLE elective_group_units (
    elective_group_id UUID NOT NULL REFERENCES elective_groups(id) ON DELETE CASCADE,
    unit_id           UUID NOT NULL REFERENCES units(id)           ON DELETE CASCADE,
    PRIMARY KEY (elective_group_id, unit_id)
);

COMMENT ON TABLE elective_groups IS
    'Named pools of acceptable units for elective slots. REQ-DB-103, REQ-FUN-603(c)';


-- ===========================================================================
-- SECTION 7b — MINORS
-- Minor specialisations available within a planner template.
-- A minor groups elective units under a named track (e.g. "Big Data Analytics").
-- One unit can belong to multiple minors (cross-minor electives).
-- Units remain in elective_group_units as regular electives.
-- ===========================================================================

CREATE TABLE minors (
    id                  UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    planner_template_id UUID          NOT NULL
                            REFERENCES planner_templates(id) ON DELETE CASCADE,
    name                VARCHAR(255)  NOT NULL,
    created_at          TIMESTAMPTZ   NOT NULL DEFAULT now(),
    updated_at          TIMESTAMPTZ   NOT NULL DEFAULT now(),

    UNIQUE (planner_template_id, name)
);

CREATE TABLE minor_units (
    minor_id UUID NOT NULL REFERENCES minors(id) ON DELETE CASCADE,
    unit_id  UUID NOT NULL REFERENCES units(id)  ON DELETE CASCADE,
    PRIMARY KEY (minor_id, unit_id)
);

COMMENT ON TABLE minor_units IS
    'Units that belong to a minor. Units also exist in elective_group_units as regular electives.';


-- ===========================================================================
-- SECTION 8 — PRIVACY EVENTS LOG
-- Append-only log of all privacy notice lifecycle events.
-- No student data stored here.
-- Supports REQ-PRI-104 (presented trail), REQ-PRI-105 (consent proof),
--           REQ-PRI-108 (6-year retention).
-- ===========================================================================

CREATE TABLE privacy_events (
    id             BIGSERIAL    PRIMARY KEY,
    event_type     VARCHAR(20)  NOT NULL
                       CHECK (event_type IN ('presented', 'acknowledged', 'withdrawn')),
    notice_version INT          NOT NULL,
    occurred_at    TIMESTAMPTZ  NOT NULL DEFAULT now()
);

COMMENT ON TABLE privacy_events IS
    'Append-only privacy event log. Supports REQ-PRI-104, REQ-PRI-105, REQ-PRI-108';


-- ===========================================================================
-- SECTION 9 — SECURITY INCIDENT LOG
-- Stores anomalies during scraping/processing. NO student data stored here.
-- Supports REQ-BRE-101, REQ-BRE-102.
-- ===========================================================================

CREATE TABLE security_incident_log (
    id           BIGSERIAL    PRIMARY KEY,
    event_type   VARCHAR(50)  NOT NULL,
                 -- e.g. 'AUTH_FAILURE', 'UNEXPECTED_PORTAL_RESPONSE'
    severity     VARCHAR(20)  NOT NULL DEFAULT 'warning'
                     CHECK (severity IN ('info', 'warning', 'error', 'critical')),
    message      TEXT         NOT NULL,
    -- Deliberately NO student_id column (REQ-BRE-102, REQ-SEC-101)
    occurred_at  TIMESTAMPTZ  NOT NULL DEFAULT now()
);

COMMENT ON TABLE security_incident_log IS
    'Security/anomaly log. Must NEVER contain student data. REQ-BRE-101, REQ-BRE-102';


-- ===========================================================================
-- SECTION 10 — AUDIT LOG
-- Tracks administrative actions on planner data (uploads, edits, deletions).
-- Supports traceability; no student data stored.
-- ===========================================================================

CREATE TABLE audit_log (
    id            BIGSERIAL    PRIMARY KEY,
    action        VARCHAR(50)  NOT NULL,
                  -- e.g. 'PLANNER_UPLOAD', 'UNIT_EDIT', 'MAJOR_CREATE'
    entity_type   VARCHAR(50),
                  -- e.g. 'planner_templates', 'units', 'majors'
    entity_id     UUID,
    old_value     JSONB,
    new_value     JSONB,
    performed_at  TIMESTAMPTZ  NOT NULL DEFAULT now()
);

COMMENT ON TABLE audit_log IS
    'Administrative action audit trail. No student data. REQ-LGL-102';


-- ===========================================================================
-- SECTION 11 — INDEXES FOR QUERY PERFORMANCE
-- Supports REQ-PER-101 (<5 s major detection) and REQ-SCA-102 (300+ planners).
-- ===========================================================================

-- Major detection path: course_id -> (optional major_id) -> intake_year -> intake_month
-- course_id alone pre-filters all templates for a student's enrolled course
CREATE INDEX idx_planner_course              ON planner_templates(course_id);
CREATE INDEX idx_planner_course_major        ON planner_templates(course_id, major_id);
CREATE INDEX idx_planner_course_intake       ON planner_templates(course_id, intake_year, intake_month);

-- Fast lookup of units by code (primary matching key)
CREATE INDEX idx_units_code                  ON units(unit_code);

-- Requisite chain lookups
CREATE INDEX idx_requisite_group_unit     ON unit_requisite_groups(unit_id);
CREATE INDEX idx_requisite_cond_group     ON unit_requisite_conditions(group_id);
CREATE INDEX idx_requisite_cond_unit      ON unit_requisite_conditions(unit_id);

-- Elective resolution
CREATE INDEX idx_elective_group_template     ON elective_groups(planner_template_id);

-- Minor resolution
CREATE INDEX idx_minors_planner ON minors(planner_template_id);
CREATE INDEX idx_minor_units_unit  ON minor_units(unit_id);

-- Incident log and audit log chronological queries
CREATE INDEX idx_incident_occurred           ON security_incident_log(occurred_at DESC);
CREATE INDEX idx_audit_performed             ON audit_log(performed_at DESC);


-- ===========================================================================
-- SECTION 12 — UPDATED_AT TRIGGERS
-- Automatically stamps updated_at on any UPDATE.
-- ===========================================================================

CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_courses_updated_at
    BEFORE UPDATE ON courses
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_majors_updated_at
    BEFORE UPDATE ON majors
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_units_updated_at
    BEFORE UPDATE ON units
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_planner_templates_updated_at
    BEFORE UPDATE ON planner_templates
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_system_config_updated_at
    BEFORE UPDATE ON system_config
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_template_units_updated_at
    BEFORE UPDATE ON template_units
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_elective_groups_updated_at
    BEFORE UPDATE ON elective_groups
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_minors_updated_at
    BEFORE UPDATE ON minors
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();


-- ===========================================================================
-- SECTION 13 — SCHEMA VERSION TRACKING
-- Simple migration versioning for Sprint-based change control (Section 7.1).
-- ===========================================================================

CREATE TABLE schema_migrations (
    version     VARCHAR(50)  PRIMARY KEY,
    description TEXT,
    applied_at  TIMESTAMPTZ  NOT NULL DEFAULT now()
);

INSERT INTO schema_migrations (version, description)
VALUES ('1.7.0', 'Restructured requisite tables (renamed from prerequisite) and added requisite_type column to unit_requisite_conditions. Sprint 3');


-- ===========================================================================
-- SECTION 14 — helper function
-- ===========================================================================

-- Helper: add a simple requisite (one group, one condition)
CREATE OR REPLACE FUNCTION add_prereq_unit(
    p_target  VARCHAR,
    p_prereq  VARCHAR,
    p_requisite_type VARCHAR DEFAULT 'prerequisite'
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    v_target_id UUID;
    v_prereq_id UUID;
    v_group_id  UUID;
BEGIN
    SELECT id INTO STRICT v_target_id FROM units WHERE unit_code = p_target;
    SELECT id INTO STRICT v_prereq_id FROM units WHERE unit_code = p_prereq;

    INSERT INTO unit_requisite_groups (unit_id)
    VALUES (v_target_id)
    RETURNING id INTO v_group_id;

    INSERT INTO unit_requisite_conditions (group_id, type, unit_id, requisite_type)
    VALUES (v_group_id, 'unit', v_prereq_id, p_requisite_type);
END;
$$;


-- Helper: add a credit-point requisite
CREATE OR REPLACE FUNCTION add_prereq_credits(
    p_target        VARCHAR,
    p_credit_points NUMERIC
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    v_target_id UUID;
    v_group_id  UUID;
BEGIN
    SELECT id INTO STRICT v_target_id FROM units WHERE unit_code = p_target;

    INSERT INTO unit_requisite_groups (unit_id)
    VALUES (v_target_id)
    RETURNING id INTO v_group_id;

    INSERT INTO unit_requisite_conditions (group_id, type, credit_points)
    VALUES (v_group_id, 'credit_points', p_credit_points);
END;
$$;


-- Helper: add an AND group (multiple units that ALL must be completed)
CREATE OR REPLACE FUNCTION add_prereq_and_group(
    p_target  VARCHAR,
    p_prereqs VARCHAR[]
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    v_target_id UUID;
    v_group_id  UUID;
    v_code      VARCHAR;
    v_prereq_id UUID;
BEGIN
    SELECT id INTO STRICT v_target_id FROM units WHERE unit_code = p_target;

    INSERT INTO unit_requisite_groups (unit_id)
    VALUES (v_target_id)
    RETURNING id INTO v_group_id;

    FOREACH v_code IN ARRAY p_prereqs LOOP
        SELECT id INTO STRICT v_prereq_id FROM units WHERE unit_code = v_code;
        INSERT INTO unit_requisite_conditions (group_id, type, unit_id, requisite_type)
        VALUES (v_group_id, 'unit', v_prereq_id, 'prerequisite');
    END LOOP;
END;
$$;


-- Helper: add an OR relationship (each prereq gets its OWN group)
CREATE OR REPLACE FUNCTION add_prereq_or(
    p_target  VARCHAR,
    p_prereqs VARCHAR[]
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    v_target_id UUID;
    v_group_id  UUID;
    v_code      VARCHAR;
    v_prereq_id UUID;
BEGIN
    SELECT id INTO STRICT v_target_id FROM units WHERE unit_code = p_target;

    FOREACH v_code IN ARRAY p_prereqs LOOP
        SELECT id INTO STRICT v_prereq_id FROM units WHERE unit_code = v_code;

        INSERT INTO unit_requisite_groups (unit_id)
        VALUES (v_target_id)
        RETURNING id INTO v_group_id;

        INSERT INTO unit_requisite_conditions (group_id, type, unit_id, requisite_type)
        VALUES (v_group_id, 'unit', v_prereq_id, 'prerequisite');
    END LOOP;
END;
$$;

-- ========================================================


-- Helper: resolve a course id by code
CREATE OR REPLACE FUNCTION get_course_id(p_code VARCHAR)
RETURNS UUID LANGUAGE plpgsql AS $$
DECLARE v_id UUID;
BEGIN
    SELECT id INTO STRICT v_id FROM courses WHERE code = p_code;
    RETURN v_id;
END;
$$;

-- Helper: resolve a major id by course code + major name
CREATE OR REPLACE FUNCTION get_major_id(p_course_code VARCHAR, p_major_name VARCHAR)
RETURNS UUID LANGUAGE plpgsql AS $$
DECLARE v_id UUID;
BEGIN
    SELECT m.id INTO STRICT v_id
    FROM majors m
    JOIN courses c ON c.id = m.course_id
    WHERE c.code = p_course_code
      AND m.name = p_major_name;
    RETURN v_id;
END;
$$;


-- Helper: create a planner template and return its id
CREATE OR REPLACE FUNCTION create_planner_template(
    p_course_code  VARCHAR,
    p_major_name   VARCHAR,   -- NULL if no major
    p_intake_year  SMALLINT,
    p_intake_month SMALLINT   -- NULL if year-level template
) RETURNS UUID LANGUAGE plpgsql AS $$
DECLARE
    v_id UUID;
BEGIN
    INSERT INTO planner_templates (course_id, major_id, intake_year, intake_month)
    VALUES (
        get_course_id(p_course_code),
        CASE WHEN p_major_name IS NULL THEN NULL
             ELSE get_major_id(p_course_code, p_major_name) END,
        p_intake_year,
        p_intake_month
    )
    RETURNING id INTO v_id;

    RETURN v_id;
END;
$$;


-- Helper: add units to a template
CREATE OR REPLACE FUNCTION add_template_units(
    p_template_id  UUID,
    p_units        VARCHAR[]   -- flat array: ARRAY['CODE','category',year,sem, ...]
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    i INT;
BEGIN
    i := 1;
    WHILE i < array_length(p_units, 1) LOOP
        INSERT INTO template_units (planner_template_id, unit_id, category, year_level, semester)
        SELECT
            p_template_id,
            u.id,
            p_units[i + 1]::unit_category,
            p_units[i + 2]::SMALLINT,
            p_units[i + 3]::SMALLINT
        FROM units u
        WHERE u.unit_code = p_units[i];

        i := i + 4;
    END LOOP;
END;
$$;


-- Helper: add elective slots (NULL unit_id) to a template
CREATE OR REPLACE FUNCTION add_elective_slots(
    p_template_id UUID,
    p_slots       SMALLINT[]  -- flat array: ARRAY[year,sem, year,sem, ...]
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    i INT;
BEGIN
    i := 1;
    WHILE i < array_length(p_slots, 1) LOOP
        INSERT INTO template_units (planner_template_id, unit_id, category, year_level, semester)
        VALUES (p_template_id, NULL, 'elective', p_slots[i], p_slots[i + 1]);

        i := i + 2;
    END LOOP;
END;
$$;

-- Helper: resolve a planner template id by human-readable keys
CREATE OR REPLACE FUNCTION get_template_id(
    p_course_code  VARCHAR,
    p_major_name   VARCHAR,
    p_intake_year  SMALLINT,
    p_intake_month SMALLINT
) RETURNS UUID LANGUAGE plpgsql AS $$
DECLARE
    v_id UUID;
BEGIN
    SELECT pt.id INTO STRICT v_id
    FROM planner_templates pt
    JOIN courses c ON c.id = pt.course_id
    LEFT JOIN majors m ON m.id = pt.major_id
    WHERE c.code = p_course_code
      AND (p_major_name IS NULL AND pt.major_id IS NULL OR m.name = p_major_name)
      AND pt.intake_year = p_intake_year
      AND (p_intake_month IS NULL AND pt.intake_month IS NULL OR pt.intake_month = p_intake_month);

    RETURN v_id;
END;
$$;


-- Helper: create an elective group and populate it with units
CREATE OR REPLACE FUNCTION add_elective_group(
    p_course_code   VARCHAR,
    p_major_name    VARCHAR,
    p_intake_year   SMALLINT,
    p_intake_month  SMALLINT,
    p_unit_codes    VARCHAR[]
) RETURNS UUID LANGUAGE plpgsql AS $$
DECLARE
    v_template_id     UUID;
    v_elective_grp_id UUID;
    v_unit_code       VARCHAR;
    v_unit_id         UUID;
BEGIN
    v_template_id := get_template_id(p_course_code, p_major_name, p_intake_year, p_intake_month);

    INSERT INTO elective_groups (planner_template_id)
    VALUES (v_template_id)
    RETURNING id INTO v_elective_grp_id;

    FOREACH v_unit_code IN ARRAY p_unit_codes LOOP
        SELECT id INTO STRICT v_unit_id FROM units WHERE unit_code = v_unit_code;

        INSERT INTO elective_group_units (elective_group_id, unit_id)
        VALUES (v_elective_grp_id, v_unit_id);
    END LOOP;

    RETURN v_elective_grp_id;
END;
$$;


-- Helper: add an AND group with mixed condition types
CREATE OR REPLACE FUNCTION add_prereq_mixed_group(
    p_target     VARCHAR,
    p_conditions VARCHAR[]
) RETURNS VOID LANGUAGE plpgsql AS $$
DECLARE
    v_target_id UUID;
    v_group_id  UUID;
    v_type      VARCHAR;
    v_value     VARCHAR;
    v_unit_id   UUID;
    i           INT;
BEGIN
    SELECT id INTO STRICT v_target_id FROM units WHERE unit_code = p_target;

    INSERT INTO unit_requisite_groups (unit_id)
    VALUES (v_target_id)
    RETURNING id INTO v_group_id;

    i := 1;
    WHILE i < array_length(p_conditions, 1) LOOP
        v_type  := p_conditions[i];
        v_value := p_conditions[i + 1];

        IF v_type = 'unit' THEN
            SELECT id INTO STRICT v_unit_id FROM units WHERE unit_code = v_value;
            INSERT INTO unit_requisite_conditions (group_id, type, unit_id, requisite_type)
            VALUES (v_group_id, 'unit', v_unit_id, 'prerequisite');

        ELSIF v_type = 'credit_points' THEN
            INSERT INTO unit_requisite_conditions (group_id, type, credit_points)
            VALUES (v_group_id, 'credit_points', v_value::NUMERIC);
        END IF;

        i := i + 2;
    END LOOP;
END;
$$;


