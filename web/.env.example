# Copy to `web/.env`. Used in development and by `npm run build:python`.
#
# The Python of the virtual environment for the planner PDF extractor (section "Python environment" in docs/ai):
#   python3 -m venv core/services/plannerImport/.venv
#   core/services/plannerImport/.venv/bin/pip install -r core/services/plannerImport/requirements.txt
# macOS and Linux: .../.venv/bin/python     Windows: ...\.venv\Scripts\python.exe
PYTHON_EXECUTABLE=/full/path/to/FYPA-StudyPlannerSystem/core/services/plannerImport/.venv/bin/python
