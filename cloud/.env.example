# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin

# Generate with:
#   node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH_B64=

# Random 32+ char secret for signing session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Database — for local dev, this points to the Docker db service on port 5433
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://fypa:<password>@localhost:5434/fypa_cloud"

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
# Set to true to use simulated scraper data (no real Puppeteer)
SCRAPER_SIMULATE=true

# Directory where downloaded PDFs are saved
PLANNER_PDF_DIR=/tmp/planners
