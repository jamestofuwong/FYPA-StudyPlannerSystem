# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ---------------------------------------------------------------------------
# Database — for local dev, this points to the Docker db service on port 5433
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://fypa:<password>@localhost:5434/fypa_cloud"

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
# Set to true to use simulated scraper data (no real Puppeteer)
SCRAPER_SIMULATE=true

# Directory where downloaded PDFs are saved
PLANNER_PDF_DIR=/tmp/planners
