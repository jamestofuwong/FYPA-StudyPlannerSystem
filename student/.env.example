# Copy to `student/.env`. The student app stops the build if DATABASE_URL or CMS_JWT_SECRET is missing.

# Any PostgreSQL URL for local work. For Supabase, use the Session pooler string (port 5432) with the real password
# (encode special characters).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# A random string of 32 bytes or more. Make one with:  openssl rand -base64 32
# Use a different value for each environment (local, staging, production).
CMS_JWT_SECRET=

# The first CMS administrator, created by `npm run db:seed`. The defaults in prisma/seed.ts are public (admin@example.com),
# so set all three before you seed a shared database. Keep a line commented to use the default: an empty value (KEY=)
# overrides the default with nothing.
# CMS_SEED_EMAIL=you@example.com
# CMS_SEED_PASSWORD=choose-a-strong-password
# CMS_SEED_NAME=Your Name

# Optional. When set (even to an empty string), it replaces DATABASE_URL at run time. It holds the POOLED string (port 6543).
# DATABASE_URL_UNPOOLED=
