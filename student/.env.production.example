# Copy to `student/.env.production`. Read only by `npm run db:migrate:prod`, `db:seed:prod` and `db:studio:prod`.
# The deployed site gets its variables from the Vercel project settings, not from this file.

# The Supabase Session pooler string of the environment that you seed (port 5432, user postgres.<project-ref>).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The defaults in prisma/seed.ts are public, so set all three before you seed a shared database. Keep a line commented to
# use the default: an empty value (KEY=) overrides the default with nothing.
# CMS_SEED_EMAIL=you@example.com
# CMS_SEED_PASSWORD=choose-a-strong-password
# CMS_SEED_NAME=Your Name
