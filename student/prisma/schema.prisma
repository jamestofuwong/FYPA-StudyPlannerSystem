// Student-facing interface schema.
// The study-planner tables mirror the main app schema so seed/snapshot data can
// be copied without reshaping planner structure. Student-only CMS/help/unit-detail
// tables stay here because the main app does not own that content.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String?           @unique @db.VarChar(50)
  name       String            @db.VarChar(255)
  created_at DateTime          @default(now()) @db.Timestamptz
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz
  majors     Major[]
  templates  PlannerTemplate[]

  @@map("courses")
}

model Major {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id  String            @db.Uuid
  course     Course            @relation(fields: [course_id], references: [id], onDelete: Restrict)
  name       String            @db.VarChar(255)
  created_at DateTime          @default(now()) @db.Timestamptz
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz
  templates  PlannerTemplate[]

  @@unique([course_id, name])
  @@map("majors")
}

model Unit {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_code            String                   @unique @db.VarChar(20)
  unit_name            String                   @db.VarChar(255)
  is_active            Boolean                  @default(true)
  replaced_by_unit_id  String?                  @db.Uuid
  replaced_by          Unit?                    @relation("UnitReplacement", fields: [replaced_by_unit_id], references: [id], onDelete: SetNull)
  replaces_units       Unit[]                   @relation("UnitReplacement")
  credit_points        Decimal                  @default(12.5) @db.Decimal(5, 1)
  year_level           Int                      @default(1) @db.SmallInt
  overview             String?                  @db.Text
  created_at           DateTime                 @default(now()) @db.Timestamptz
  updated_at           DateTime                 @default(now()) @updatedAt @db.Timestamptz
  offerings            UnitOffering[]
  templates            TemplateUnit[]
  requisite_groups     UnitRequisiteGroup[]
  requisite_conditions UnitRequisiteCondition[] @relation("RequisiteUnit")
  elective_group_units ElectiveGroupUnit[]
  minor_units          MinorUnit[]
  learning_outcomes    UnitLearningOutcome[]
  content_topics       UnitContentTopic[]
  assessments          UnitAssessment[]

  @@map("units")
}

model UnitOffering {
  unit_id    String   @db.Uuid
  unit       Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  offered_in Int      @map("offered_in") @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@id([unit_id, offered_in])
  @@map("unit_offerings")
}

model UnitRequisiteGroup {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id    String                   @db.Uuid
  unit       Unit                     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  conditions UnitRequisiteCondition[]

  @@map("unit_requisite_groups")
}

model UnitRequisiteCondition {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id           String             @db.Uuid
  group              UnitRequisiteGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  type               String             @db.VarChar(20)
  unit_id            String?            @db.Uuid
  unit               Unit?              @relation("RequisiteUnit", fields: [unit_id], references: [id], onDelete: Cascade)
  credit_points      Decimal?           @db.Decimal(5, 1)
  requisite_type     String?            @db.VarChar(20)
  external_requisite String?            @db.VarChar(255)

  @@map("unit_requisite_conditions")
}

model PlannerTemplate {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id          String          @db.Uuid
  course             Course          @relation(fields: [course_id], references: [id], onDelete: Restrict)
  major_id           String?         @db.Uuid
  major              Major?          @relation(fields: [major_id], references: [id], onDelete: Restrict)
  intake_year        Int             @db.SmallInt
  intake_month       Int?            @db.SmallInt
  course_type        String          @default("bachelor") @db.VarChar(50)
  duration_semesters Int             @default(6) @db.SmallInt
  core_count         Int?            @db.SmallInt
  core_cp            Int?            @db.SmallInt
  major_count        Int?            @db.SmallInt
  major_cp           Int?            @db.SmallInt
  elective_count     Int?            @db.SmallInt
  elective_cp        Int?            @db.SmallInt
  wil_count          Int?            @db.SmallInt
  wil_cp             Int?            @db.SmallInt
  created_at         DateTime        @default(now()) @db.Timestamptz
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz
  units              TemplateUnit[]
  elective_groups    ElectiveGroup[]
  minors             Minor[]

  @@unique([course_id, major_id, intake_year, intake_month])
  @@map("planner_templates")
}

enum unit_category {
  core
  major_core
  prescribed_elective
  elective
  wil
  mpu
}

model TemplateUnit {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_template_id String          @db.Uuid
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id], onDelete: Cascade)
  unit_id             String?         @db.Uuid
  unit                Unit?           @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  category            unit_category
  year_level          Int             @db.SmallInt
  semester            Int             @db.SmallInt
  created_at          DateTime        @default(now()) @db.Timestamptz
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz

  @@unique([planner_template_id, unit_id])
  @@map("template_units")
}

model ElectiveGroup {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_template_id String              @db.Uuid
  template            PlannerTemplate     @relation(fields: [planner_template_id], references: [id], onDelete: Cascade)
  created_at          DateTime            @default(now()) @db.Timestamptz
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz
  units               ElectiveGroupUnit[]

  @@map("elective_groups")
}

model ElectiveGroupUnit {
  elective_group_id String        @db.Uuid
  elective_group    ElectiveGroup @relation(fields: [elective_group_id], references: [id], onDelete: Cascade)
  unit_id           String        @db.Uuid
  unit              Unit          @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([elective_group_id, unit_id])
  @@map("elective_group_units")
}

model Minor {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_template_id String          @db.Uuid
  template            PlannerTemplate @relation(fields: [planner_template_id], references: [id], onDelete: Cascade)
  name                String          @db.VarChar(255)
  created_at          DateTime        @default(now()) @db.Timestamptz
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz
  units               MinorUnit[]

  @@unique([planner_template_id, name])
  @@map("minors")
}

model MinorUnit {
  minor_id String @db.Uuid
  minor    Minor  @relation(fields: [minor_id], references: [id], onDelete: Cascade)
  unit_id  String @db.Uuid
  unit     Unit   @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([minor_id, unit_id])
  @@map("minor_units")
}

model UnitLearningOutcome {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id     String   @db.Uuid
  unit        Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  ulo_number  Int      @db.SmallInt
  description String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([unit_id, ulo_number])
  @@map("unit_learning_outcomes")
}

model UnitContentTopic {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id    String   @db.Uuid
  unit       Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  position   Int      @db.SmallInt
  topic      String   @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([unit_id, position])
  @@map("unit_content_topics")
}

model UnitAssessment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id    String   @db.Uuid
  unit       Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(255)
  type       String   @db.VarChar(100)
  weight     Int      @db.SmallInt
  ulos       Int[]
  position   Int      @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("unit_assessments")
}

model FaqItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question   String   @db.Text
  answer     String   @db.Text
  position   Int      @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("faq_items")
}

model GeneralEnquiries {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_name  String   @db.VarChar(255)
  location    String   @db.VarChar(255)
  hours       String   @db.VarChar(255)
  closed_note String?  @db.VarChar(255)
  updated_at  DateTime @updatedAt @db.Timestamptz

  @@map("general_enquiries")
}

model ItHelpDesk {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telephone     String   @db.VarChar(50)
  email         String   @db.VarChar(255)
  location      String   @db.VarChar(100)
  hours_mon_thu String   @db.VarChar(255)
  hours_fri     String   @db.VarChar(255)
  closed_note   String?  @db.VarChar(255)
  updated_at    DateTime @updatedAt @db.Timestamptz

  @@map("it_help_desk")
}

model HeadOfDepartment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  faculty    String   @db.VarChar(255)
  department String   @db.VarChar(255)
  name       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  position   Int      @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("heads_of_department")
}

model CmsUser {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String            @unique @db.VarChar(255)
  password_hash  String            @db.Text
  name           String            @db.VarChar(255)
  created_at     DateTime          @default(now()) @db.Timestamptz
  updated_at     DateTime          @default(now()) @updatedAt @db.Timestamptz
  refresh_tokens CmsRefreshToken[]

  @@map("cms_users")
}

model CmsRefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  user       CmsUser  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String   @db.Text
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("cms_refresh_tokens")
}
