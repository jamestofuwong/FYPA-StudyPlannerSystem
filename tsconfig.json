{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.tsx",
    "core/**/*.ts",
    "core/**/*.tsx",
    "core/**/*.d.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
, "tests/matching/matching.phase2test.ts", "tests/matching/matching.test.ts"  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "web/.next"
  ]
}
