# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=fypa_cloud
POSTGRES_USER=fypa
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Cloud app
# ---------------------------------------------------------------------------
# Port the cloud app listens on (host side)
CLOUD_PORT=3001

# Set to true to use simulated scraper data (no real Puppeteer)
SCRAPER_SIMULATE=false

# ---------------------------------------------------------------------------
# Local desktop app → cloud sync
# ---------------------------------------------------------------------------
# URL of the running cloud app. Used by the local app's Cloud Sync feature
# to pull parsed planners from the cloud database into the local database.
# In development this is usually http://localhost:3001 (Docker cloud app).
# In production, set this to the deployed cloud URL.
CLOUD_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Cloud admin login
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin

# Generate with:
#   node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH_B64=

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Production only (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Your GitHub org/user and repo name, e.g. "jameswong/fypa-cloud"
GITHUB_REPO=your-org/fypa-cloud
IMAGE_TAG=latest
